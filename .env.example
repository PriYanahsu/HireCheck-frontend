# Frontend (Vercel) — copy to client/.env.local for local overrides
# (Vite root is client/, so env files must live there)

# Leave empty locally — Vite proxies /api → http://127.0.0.1:8080
# On Vercel / local-vs-Render set to your API URL (no trailing slash):
# VITE_API_URL=https://your-api.onrender.com
VITE_API_URL=

# Optional ImageKit (public keys only)
VITE_IMAGEKIT_PUBLIC_KEY=
VITE_IMAGEKIT_URL_ENDPOINT=
